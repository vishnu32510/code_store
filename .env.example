# App branding & API (copy to .env locally)
APP_DISPLAY_NAME=My App
BASE_URL=https://api.example.com/

# Legal pages — GitHub Pages (docs/ folder); replace YOUR_GITHUB_USER and YOUR_REPO
PRIVACY_POLICY_URL=https://YOUR_GITHUB_USER.github.io/YOUR_REPO/privacy.html
TERMS_URL=https://YOUR_GITHUB_USER.github.io/YOUR_REPO/terms.html
SUPPORT_URL=https://YOUR_GITHUB_USER.github.io/YOUR_REPO/support.html
